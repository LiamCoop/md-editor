generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentVisibility {
  PRIVATE
  LINK
}

model User {
  id           String           @id @default(cuid())
  authProvider String
  authUserId   String
  email        String?
  name         String?
  image        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  documents    Document[]       @relation("DocumentOwner")
  memberships  DocumentMember[]

  @@unique([authProvider, authUserId])
  @@index([email])
}

model Document {
  id                  String             @id @default(cuid())
  automergeIdentifier String             @unique
  title               String
  visibility          DocumentVisibility @default(PRIVATE)
  ownerId             String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  owner               User               @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members             DocumentMember[]

  @@index([ownerId])
  @@index([updatedAt])
}

model DocumentMember {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId])
}
